# ─────────────────────────────────────────────────────────────
# Praxis Center platform — environment variables
# Copy to .env.local (Next.js) and .env (scripts) and fill in.
# Never commit real values.
# ─────────────────────────────────────────────────────────────

# Public base URL (no trailing slash). Used in emails, sitemap, OG tags.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# "coming_soon" shows only the coming-soon page publicly; "live" shows the full site.
SITE_MODE=live
# Visit /preview?key=<PREVIEW_KEY> to bypass coming-soon mode in your browser.
PREVIEW_KEY=change-me

# ── Database (Supabase Postgres) ─────────────────────────────
# Supabase → Project Settings → Database → Connection string (Transaction pooler, port 6543)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/praxis
# Used by integration tests only
DATABASE_URL_TEST=postgres://postgres:postgres@localhost:5432/praxis_test

# ── Supabase (Auth + Storage) ────────────────────────────────
# Leave empty for local dev: uploads go to ./.data/uploads and dev login is available.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Auth ─────────────────────────────────────────────────────
# Random 32+ char string; signs guest order links and dev sessions. `openssl rand -hex 32`
AUTH_SECRET=replace-with-a-long-random-string
# Comma-separated emails that become super_admin on first sign-in.
SUPER_ADMIN_EMAILS=
# Local development only; ignored when NODE_ENV=production.
ALLOW_DEV_LOGIN=true

# ── Email (Resend) ───────────────────────────────────────────
# Leave empty to log emails to the console instead of sending.
RESEND_API_KEY=
EMAIL_FROM="Praxis Center <registrar@praxiscenter.ph>"
# Fallback recipients for admin alerts (comma-separated) when none are set in Admin → Settings.
ADMIN_NOTIFICATION_EMAILS=

# ── Scheduled jobs ───────────────────────────────────────────
# Vercel Cron sends "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=replace-with-a-random-string

# ── Anti-abuse ───────────────────────────────────────────────
# Cloudflare Turnstile (optional in dev; strongly recommended in production)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Upstash Redis for rate limiting (optional; falls back to in-memory per instance)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Analytics (loaded only after cookie consent) ─────────────
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_META_PIXEL_ID=
